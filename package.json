{
  "name": "sheetmusic",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-model.mjs",
    "dev": "vite",
    "dev:ipad": "vite --host --mode ipad",
    "prebuild": "node scripts/copy-model.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "pretest": "node scripts/copy-model.mjs",
    "test": "vitest run",
    "typecheck": "tsc",
    "songs": "node scripts/generate-songs.mjs"
  },
  "dependencies": {
    "@spotify/basic-pitch": "^1.0.1",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "opensheetmusicdisplay": "^2.1.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tone": "^15.1.22"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "@spotify/basic-pitch": {
      "@tensorflow/tfjs": "4.22.0"
    }
  }
}
